# Copy this file to .env and paste your key. Never commit .env.
OPENROUTER_API_KEY=
# Optional: another provider that serves the OpenAI API shape
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# Optional: other models (any free open-weight chat model, a smaller one, an open multilingual embedding model)
# ANLP_MODEL=google/gemma-4-31b-it:free
# ANLP_SMALL_MODEL=liquid/lfm-3-1.7b:free
# ANLP_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
# ANLP_QUICK=1      smaller samples: fits a free daily quota and a quick check
# ANLP_CACHE=0      send every request to the model again
# ANLP_STANDIN=1    never call a model: a scripted stand-in answers (for checking that the notebooks run)
